name: tapa1
description: A new Flutter project.
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.0.6 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter

  cupertino_icons: ^1.0.2

  # Firebase - VERSIONS COMPATIBLES AVEC DART 3.2.6
  firebase_core: 2.15.0
  cloud_firestore: 4.8.0
  firebase_auth: 4.7.0

  http: ^1.1.0
  provider: ^6.1.5+1
  intl: ^0.18.0
  go_router: ^13.1.0
  shared_preferences: ^2.2.2
  printing: ^5.12.0
  pdf: ^3.10.9
  url_launcher: ^6.1.0
  image_picker: ^1.0.0
  google_mlkit_text_recognition: ^0.12.0
  speech_to_text: ^6.6.0
  flutter_local_notifications: ^17.1.0
  timezone: ^0.9.2

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^2.0.0

flutter:
  uses-material-design: true
